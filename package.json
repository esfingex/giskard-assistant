{
  "name": "giskard-assistant",
  "displayName": "Giskard Assistant — Sovereign AI Connector",
  "description": "Sovereign sidebar chat supporting Ollama, Gemini CLI, Claude CLI, and external AI APIs.",
  "version": "4.2.0",
  "publisher": "giskard",
  "icon": "resources/icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/esfingex/giskard-assistant"
  },
  "license": "GPL-3.0",
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": [
    "Machine Learning",
    "Programming Languages",
    "Other"
  ],
  "main": "./out/extension.js",
  "scripts": {
    "compile": "tsc -p ./",
    "package": "npx --yes @vscode/vsce package --no-dependencies --allow-star-activation"
  },
  "activationEvents": [
    "onView:giskard.chatView",
    "onView:giskard-local-models",
    "onView:giskard-remote-connections",
    "onView:giskard-model-settings",
    "onView:giskard-theme-palette",
    "*"
  ],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "giskard-explorer",
          "title": "Giskard",
          "icon": "giskard.svg"
        }
      ]
    },
    "views": {
      "giskard-explorer": [
        {
          "id": "giskard-local-models",
          "name": "Local & Active LLM Models",
          "icon": "$(server-environment)"
        },
        {
          "id": "giskard-remote-connections",
          "name": "Remote AI Connections",
          "icon": "$(cloud)"
        },
        {
          "id": "giskard-model-settings",
          "name": "⚙️ Model Settings",
          "type": "webview"
        },
        {
          "id": "giskard-theme-palette",
          "name": "🎨 Visual Palette & UI Theme",
          "icon": "$(symbol-color)"
        },
        {
          "id": "giskard.chatView",
          "name": "💬 Giskard Assistant Chat",
          "type": "webview"
        }
      ]
    },
    "commands": [
      {
        "command": "giskard-assistant.manageApiKey",
        "title": "Gestionar API Keys y Tokens de Autenticación",
        "icon": "$(key)"
      },
      {
        "command": "giskard-assistant.filterCapabilities",
        "title": "Filtrar Modelos por Capacidad (🧠 🛠️ 👁️ 🧩)",
        "icon": "$(filter)"
      },
      {
        "command": "giskard-assistant.searchModels",
        "title": "Buscar y Filtrar Modelos por Nombre",
        "icon": "$(search)"
      },
      {
        "command": "giskard-assistant.addServer",
        "title": "Agregar Servidor / Conexión IA",
        "icon": "$(add)"
      },
      {
        "command": "giskard-assistant.refreshTree",
        "title": "Refrescar Servidores y Modelos",
        "icon": "$(refresh)"
      },
      {
        "command": "giskard-assistant.openSettingsModal",
        "title": "Abrir Ajustes de Extensión",
        "icon": "$(settings-gear)"
      },
      {
        "command": "giskard-assistant.openChat",
        "title": "Giskard Assistant: Abrir Chat en Barra Principal (Izquierda)",
        "icon": "$(robot)"
      },
      {
        "command": "giskard-assistant.openChatRight",
        "title": "Giskard Assistant: Abrir Chat en Barra Secundaria (Derecha)",
        "icon": "$(robot)"
      },
      {
        "command": "giskard-assistant.syncState",
        "title": "Giskard Assistant: Sincronizar Estado con Conector Soberano"
      },
      {
        "command": "giskard-assistant.listSandbox",
        "title": "Giskard-Sys: List Sandbox Files"
      },
      {
        "command": "giskard-assistant.readSandboxFile",
        "title": "Giskard-Sys: Read File from Sandbox"
      },
      {
        "command": "giskard-assistant.attachCodeToChat",
        "title": "Giskard Assistant: Adjuntar Código Seleccionado al Chat (Ctrl+L)",
        "icon": "$(code)"
      }
    ],
    "keybindings": [
      {
        "command": "giskard-assistant.attachCodeToChat",
        "key": "ctrl+l",
        "when": "editorTextFocus"
      }
    ],
    "configuration": {
      "title": "Giskard Assistant",
      "properties": {
        "giskard-assistant.connectorUrl": {
          "type": "string",
          "default": "http://localhost:3500",
          "description": "URL del backend soberano al que se conecta el asistente."
        },
        "giskard-assistant.clientId": {
          "type": "string",
          "default": "VSCode-Copilot",
          "description": "Identificador de cliente enviado en la cabecera X-Client-Id."
        },
        "giskard-assistant.defaultModel": {
          "type": "string",
          "default": "auto",
          "description": "Modelo por defecto seleccionado en el chat ('auto' detecta el primer modelo activo disponible)."
        },
        "giskard-assistant.autoSync": {
          "type": "boolean",
          "default": true,
          "description": "Sincronización automática de estado y modelos."
        },
        "giskard-assistant.mcpConfigPath": {
          "type": "string",
          "default": "./mcp_conf.js",
          "description": "Ruta al archivo de configuración de servidores MCP (mcp_conf.js o config.json)."
        },
        "giskard-assistant.ollamaUrl": {
          "type": "string",
          "default": "http://127.0.0.1:11434",
          "description": "URL base de la instancia local de Ollama."
        },
        "giskard-assistant.language": {
          "type": "string",
          "enum": [
            "en",
            "es"
          ],
          "default": "en",
          "description": "Interface language for Giskard Assistant (en: English [default], es: Spanish)."
        }
      }
    },
    "menus": {
      "view/title": [
        {
          "command": "giskard-assistant.manageApiKey",
          "when": "view == giskard-remote-connections || view == giskard-local-models || view == giskard-model-settings",
          "group": "navigation@1"
        },
        {
          "command": "giskard-assistant.filterCapabilities",
          "when": "view == giskard-remote-connections || view == giskard-local-models || view == giskard-model-settings",
          "group": "navigation@2"
        },
        {
          "command": "giskard-assistant.searchModels",
          "when": "view == giskard-remote-connections || view == giskard-local-models || view == giskard-model-settings",
          "group": "navigation@3"
        },
        {
          "command": "giskard-assistant.addServer",
          "when": "view == giskard-remote-connections || view == giskard-local-models || view == giskard-model-settings",
          "group": "navigation@4"
        },
        {
          "command": "giskard-assistant.refreshTree",
          "when": "view == giskard-remote-connections || view == giskard-local-models || view == giskard-model-settings",
          "group": "navigation@5"
        },
        {
          "command": "giskard-assistant.openSettingsModal",
          "when": "view == giskard-remote-connections || view == giskard-local-models || view == giskard-model-settings",
          "group": "navigation@6"
        }
      ]
    }
  },
  "devDependencies": {
    "@types/node": "^18.0.0",
    "@types/vscode": "^1.80.0",
    "typescript": "^5.0.0"
  }
}