{
  "name": "giskard-assistant",
  "displayName": "Giskard Assistant — Local AI Connector",
  "description": "Asistente IA para VSCode con soporte nativo para Ollama local, NVIDIA NIM, DeepSeek, Moonshot Kimi, Qwen y conector opcional Giskard-Sys con Sandbox Jail.",
  "version": "4.2.6",
  "publisher": "giskard",
  "icon": "resources/icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/esfingex/giskard-assistant"
  },
  "license": "GPL-3.0",
  "engines": {
    "vscode": "^1.80.0",
    "node": ">=18.0.0"
  },
  "categories": [
    "Machine Learning",
    "Programming Languages",
    "Other"
  ],
  "main": "./out/extension.js",
  "scripts": {
    "compile": "tsc -p ./",
    "package": "npm run compile && npx --yes @vscode/vsce package --no-dependencies"
  },
  "activationEvents": [
    "onView:giskard.chatView",
    "onView:giskard-local-models",
    "onView:giskard-remote-connections",
    "onView:giskard-model-settings",
    "onView:giskard-mcp-servers",
    "onView:giskard-file-exclusions",
    "onView:giskard-theme-palette"
  ],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "giskard-explorer",
          "title": "Giskard",
          "icon": "giskard.svg"
        }
      ]
    },
    "views": {
      "giskard-explorer": [
        {
          "id": "giskard-local-models",
          "name": "Active LLM Models",
          "icon": "$(server-environment)"
        },
        {
          "id": "giskard-remote-connections",
          "name": "AI Connections & Providers",
          "icon": "$(cloud)"
        },
        {
          "id": "giskard-model-settings",
          "name": "⚙️ Model Settings",
          "type": "webview"
        },
        {
          "id": "giskard-mcp-servers",
          "name": "🛠️ MCP Servers & Tools",
          "icon": "$(tools)"
        },
        {
          "id": "giskard-file-exclusions",
          "name": "🚫 File Exclusions & Gitignore",
          "icon": "$(exclude)"
        },
        {
          "id": "giskard-theme-palette",
          "name": "🎨 Visual Palette & UI Theme",
          "icon": "$(symbol-color)"
        },
        {
          "id": "giskard.chatView",
          "name": "💬 Giskard Assistant Chat",
          "type": "webview"
        }
      ]
    },
    "commands": [
      {
        "command": "giskard-assistant.toggleConnectionActive",
        "title": "Enable / Disable AI Connection",
        "icon": "$(sync)"
      },
      {
        "command": "giskard-assistant.removeLocalModelTree",
        "title": "Remove / Unload Model",
        "icon": "$(trash)"
      },
      {
        "command": "giskard-assistant.addModelOrConnection",
        "title": "➕ Add / Pull AI Model (Ollama / Remote / Giskard-Sys)",
        "icon": "$(add)"
      },
      {
        "command": "giskard-assistant.removeRemoteConnectionTree",
        "title": "Delete AI Connection",
        "icon": "$(trash)"
      },
      {
        "command": "giskard-assistant.addRemoteConnectionTree",
        "title": "➕ Add AI Connection (Remote/Local)",
        "icon": "$(add)"
      },
      {
        "command": "giskard-assistant.addMcpServerTree",
        "title": "➕ Add MCP Server",
        "icon": "$(add)"
      },
      {
        "command": "giskard-assistant.testMcpServerTree",
        "title": "🧪 Test MCP Connection & Discover Tools",
        "icon": "$(beaker)"
      },
      {
        "command": "giskard-assistant.removeMcpServerTree",
        "title": "Delete MCP Server",
        "icon": "$(trash)"
      },
      {
        "command": "giskard-assistant.toggleMcpServerTree",
        "title": "Enable / Disable MCP Server",
        "icon": "$(sync)"
      },
      {
        "command": "giskard-assistant.toggleMcpToolTree",
        "title": "Enable / Disable MCP Tool",
        "icon": "$(sync)"
      },
      {
        "command": "giskard-assistant.addExclusionPatternTree",
        "title": "➕ Add Exclusion Pattern",
        "icon": "$(add)"
      },
      {
        "command": "giskard-assistant.removeExclusionPatternTree",
        "title": "Delete Exclusion Pattern",
        "icon": "$(trash)"
      },
      {
        "command": "giskard-assistant.selectThemeTree",
        "title": "Apply Visual Theme",
        "icon": "$(color-mode)"
      },
      {
        "command": "giskard-assistant.newChatContext",
        "title": "New Chat Context (💬✨)",
        "icon": "$(comment-discussion)"
      },
      {
        "command": "giskard-assistant.openSettingsModal",
        "title": "Open Configuration Settings",
        "icon": "$(settings-gear)"
      },
      {
        "command": "giskard-assistant.toggleModelForChat",
        "title": "Toggle Model for Chat (Multi-Select)",
        "icon": "$(check)"
      },
      {
        "command": "giskard-assistant.manageApiKey",
        "title": "Manage API Keys & Auth Tokens",
        "icon": "$(key)"
      },
      {
        "command": "giskard-assistant.filterCapabilities",
        "title": "Filter Models by Capability (🧠 🛠️ 👁️ 🧩)",
        "icon": "$(filter)"
      },
      {
        "command": "giskard-assistant.searchModels",
        "title": "Search Models by Name",
        "icon": "$(search)"
      },
      {
        "command": "giskard-assistant.addServer",
        "title": "Add AI Server / Connection",
        "icon": "$(add)"
      },
      {
        "command": "giskard-assistant.refreshTree",
        "title": "Refresh Servers & Models",
        "icon": "$(refresh)"
      },
      {
        "command": "giskard-assistant.openChat",
        "title": "Giskard Assistant: Open Chat in Primary Sidebar",
        "icon": "$(robot)"
      },
      {
        "command": "giskard-assistant.openChatRight",
        "title": "Giskard Assistant: Open Chat in Secondary Sidebar",
        "icon": "$(robot)"
      },
      {
        "command": "giskard-assistant.syncState",
        "title": "Giskard Assistant: Synchronize State"
      },
      {
        "command": "giskard-assistant.listSandbox",
        "title": "Giskard-Sys: List Sandbox Files"
      },
      {
        "command": "giskard-assistant.readSandboxFile",
        "title": "Giskard-Sys: Read File from Sandbox"
      },
      {
        "command": "giskard-assistant.attachCodeToChat",
        "title": "Giskard Assistant: Attach Selected Code to Chat (Ctrl+Shift+L)",
        "icon": "$(code)"
      }
    ],
    "keybindings": [
      {
        "command": "giskard-assistant.attachCodeToChat",
        "key": "ctrl+shift+l",
        "when": "editorTextFocus"
      }
    ],
    "configuration": {
      "title": "Giskard Assistant",
      "properties": {
        "giskard-assistant.connectorUrl": {
          "type": "string",
          "default": "http://localhost:3500",
          "description": "Backend API URL for Giskard Assistant."
        },
        "giskard-assistant.clientId": {
          "type": "string",
          "default": "giskard-assistant",
          "description": "Client identifier sent in X-Client-Id header."
        },
        "giskard-assistant.clientToken": {
          "type": "string",
          "default": "",
          "description": "Token for Giskard-Sys auth_mode=strict. If set, sent as X-Client-Token header in all Giskard-Sys calls (must match client_tokens in ~/.giskard/config.json)."
        },
        "giskard-assistant.defaultModel": {
          "type": "string",
          "default": "auto",
          "description": "Default selected model in chat ('auto' detects first available active model)."
        },
        "giskard-assistant.autoSync": {
          "type": "boolean",
          "default": true,
          "description": "Automatic synchronization of state and models."
        },
        "giskard-assistant.mcpConfigPath": {
          "type": "string",
          "default": "./mcp_conf.js",
          "description": "Path to MCP servers configuration file (mcp_conf.js or config.json, relative to workspace root)."
        },
        "giskard-assistant.ollama.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Enable Direct Local Ollama Mode (http://localhost:11434)."
        },
        "giskard-assistant.giskardSys.enabled": {
          "type": "boolean",
          "default": false,
          "description": "Enable optional Giskard-Sys Backend Connector (http://localhost:3500) for Sandbox Jail, exec and workspace mounting."
        },
        "giskard-assistant.ollamaBaseUrl": {
          "type": "string",
          "default": "http://localhost:11434",
          "description": "Base URL of local Ollama instance."
        },
        "giskard-assistant.language": {
          "type": "string",
          "enum": [
            "en",
            "es"
          ],
          "default": "en",
          "description": "Interface language for Giskard Assistant (en: English [default], es: Spanish)."
        }
      }
    },
    "menus": {
      "view/title": [
        {
          "command": "giskard-assistant.newChatContext",
          "when": "view == giskard-local-models",
          "group": "navigation@1"
        },
        {
          "command": "giskard-assistant.filterCapabilities",
          "when": "view == giskard-local-models",
          "group": "navigation@2"
        },
        {
          "command": "giskard-assistant.searchModels",
          "when": "view == giskard-local-models",
          "group": "navigation@3"
        },
        {
          "command": "giskard-assistant.refreshTree",
          "when": "view == giskard-local-models",
          "group": "navigation@4"
        },
        {
          "command": "giskard-assistant.addRemoteConnectionTree",
          "when": "view == giskard-remote-connections",
          "group": "navigation@1"
        },
        {
          "command": "giskard-assistant.addMcpServerTree",
          "when": "view == giskard-mcp-servers",
          "group": "navigation@1"
        },
        {
          "command": "giskard-assistant.addExclusionPatternTree",
          "when": "view == giskard-file-exclusions",
          "group": "navigation@1"
        }
      ],
      "view/item/context": [
        {
          "command": "giskard-assistant.testMcpServerTree",
          "when": "view == giskard-mcp-servers && viewItem == mcpServer",
          "group": "inline@1"
        },
        {
          "command": "giskard-assistant.toggleMcpServerTree",
          "when": "view == giskard-mcp-servers && viewItem == mcpServer",
          "group": "inline@2"
        },
        {
          "command": "giskard-assistant.removeMcpServerTree",
          "when": "view == giskard-mcp-servers && viewItem == mcpServer",
          "group": "inline@3"
        },
        {
          "command": "giskard-assistant.toggleMcpToolTree",
          "when": "view == giskard-mcp-servers && viewItem == mcpTool",
          "group": "inline"
        },
        {
          "command": "giskard-assistant.removeExclusionPatternTree",
          "when": "view == giskard-file-exclusions && viewItem == exclusionPattern",
          "group": "inline"
        },
        {
          "command": "giskard-assistant.toggleConnectionActive",
          "when": "view == giskard-remote-connections && viewItem == remoteConn",
          "group": "inline@1"
        },
        {
          "command": "giskard-assistant.removeRemoteConnectionTree",
          "when": "(view == giskard-remote-connections && viewItem == remoteConn) || (view == giskard-local-models && viewItem == connectionHeaderGroup)",
          "group": "inline"
        },
        {
          "command": "giskard-assistant.removeLocalModelTree",
          "when": "view == giskard-local-models && (viewItem == enabledLocalModel || viewItem == disabledLocalModel)",
          "group": "inline"
        }
      ]
    }
  },
  "dependencies": {},
  "devDependencies": {
    "@types/node": "^18.0.0",
    "@types/vscode": "^1.80.0",
    "typescript": "^5.0.0"
  }
}